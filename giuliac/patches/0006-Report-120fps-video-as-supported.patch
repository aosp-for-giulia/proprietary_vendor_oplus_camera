From 9e74de09054eae64e29ff5ee8ccde531427365b8 Mon Sep 17 00:00:00 2001
From: test <test@test.com>
Date: Sun, 4 Oct 2026 08:33:04 +0000
Subject: [PATCH] Report 120fps video as supported

---
 .../oplus/camera/configure/CameraConfig.smali | 33 +++++++++++++++++++
 1 file changed, 33 insertions(+)

diff --git a/smali/com/oplus/camera/configure/CameraConfig.smali b/smali/com/oplus/camera/configure/CameraConfig.smali
index df69f1aa..f1051762 100644
--- a/smali/com/oplus/camera/configure/CameraConfig.smali
+++ b/smali/com/oplus/camera/configure/CameraConfig.smali
@@ -1577,6 +1577,39 @@
 .method public static getConfigBooleanValue(Ljava/lang/String;)Z
     .locals 5
 
+    # Report 120fps video features as supported
+    const-string v0, "com.oplus.feature.video.4k.120fps.support"
+
+    invoke-virtual {v0, p0}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
+
+    move-result v0
+
+    if-nez v0, :cond_giuliac_120fps_on
+
+    const-string v0, "com.oplus.feature.video.1080p.120fps.support"
+
+    invoke-virtual {v0, p0}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
+
+    move-result v0
+
+    if-nez v0, :cond_giuliac_120fps_on
+
+    const-string v0, "com.oplus.feature.video.120fps.camera.main.only.support"
+
+    invoke-virtual {v0, p0}, Ljava/lang/String;->equals(Ljava/lang/Object;)Z
+
+    move-result v0
+
+    if-nez v0, :cond_giuliac_120fps_on
+
+    goto :goto_giuliac_120fps_done
+
+    :cond_giuliac_120fps_on
+    const/4 v0, 0x1
+
+    return v0
+
+    :goto_giuliac_120fps_done
     .line 1
     sget-object v0, Lcom/oplus/camera/configure/CameraConfig;->d:Ljava/util/concurrent/ConcurrentHashMap;
 
-- 
