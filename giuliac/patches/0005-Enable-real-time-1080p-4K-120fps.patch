From 9cd02d1ad26509f7e2be8463ae7507e16900246e Mon Sep 17 00:00:00 2001
From: test <test@test.com>
Date: Sun, 4 Oct 2026 08:32:05 +0000
Subject: [PATCH] Enable real-time 1080p & 4K 120fps

---
 smali_classes12/com/oplus/camera/module/a.smali | 16 ++++++++++++++++
 smali_classes12/qj/r0.smali                     |  9 +++++++++
 smali_classes3/fa/a.smali                       |  6 ++++++
 3 files changed, 31 insertions(+)

diff --git a/smali_classes12/com/oplus/camera/module/a.smali b/smali_classes12/com/oplus/camera/module/a.smali
index fc3d5cf6..0caa4f0f 100644
--- a/smali_classes12/com/oplus/camera/module/a.smali
+++ b/smali_classes12/com/oplus/camera/module/a.smali
@@ -16434,6 +16434,22 @@
 .method public d9()I
     .locals 6
 
+    # 120fps recording has to run as an Android constrained high speed
+    # session (operation mode 1): the HAL lists 1080p and 4K at 120fps
+    # only as high speed configurations.
+    invoke-virtual {p0}, Lcom/oplus/camera/module/a;->Uj()I
+
+    move-result v0
+
+    const/16 v1, 0x78
+
+    if-ne v0, v1, :cond_fps120_passthru
+
+    const/4 v0, 0x1
+
+    return v0
+
+    :cond_fps120_passthru
     .line 1
     invoke-virtual {p0}, Lcom/oplus/camera/module/BaseMode;->isFrontCamera()Z
 
diff --git a/smali_classes12/qj/r0.smali b/smali_classes12/qj/r0.smali
index ee788f9e..4a292d73 100644
--- a/smali_classes12/qj/r0.smali
+++ b/smali_classes12/qj/r0.smali
@@ -6922,6 +6922,15 @@
     .line 32
     iget v1, p1, Landroid/media/CamcorderProfile;->videoFrameRate:I
 
+    # A profile above 60fps only comes from the 120fps mode; record at the
+    # 120fps capture rate instead of the profile's stock value.
+    const/16 v2, 0x3c
+
+    if-le v1, v2, :cond_fps_not_high
+
+    const/16 v1, 0x78
+
+    :cond_fps_not_high
     .line 33
     .line 34
     invoke-virtual {v0, v1}, Landroid/media/MediaRecorder;->setVideoFrameRate(I)V
diff --git a/smali_classes3/fa/a.smali b/smali_classes3/fa/a.smali
index 06cefa9f..db2d7c8c 100644
--- a/smali_classes3/fa/a.smali
+++ b/smali_classes3/fa/a.smali
@@ -1602,8 +1602,14 @@
     move-result p0
 
     .line 92
+    # Accept 120fps as well as 60fps for the high frame rate sizes.
+    if-eq p1, p0, :cond_fps120_ok
+
+    const/16 p1, 0x78
+
     if-ne p1, p0, :cond_5
 
+    :cond_fps120_ok
     .line 93
     .line 94
     const/4 v2, 0x1
-- 
2.43.0

